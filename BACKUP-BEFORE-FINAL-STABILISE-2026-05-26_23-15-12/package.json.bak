{
  "name": "grassroots-mowing-co",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "cd client && npm run build",
    "start": "cd client && npm run dev -- --port 5173 --host 127.0.0.1",
    "dev": "cd client && npm run dev -- --port 5173 --host 127.0.0.1",
    "preview": "cd client && npm run preview",
    "frontend": "cd client && npm run dev -- --port 5173 --host 127.0.0.1",
    "frontend:build": "cd client && npm run build",
    "frontend:install": "cd client && npm install",
    "frontend:health": "cd client && npm install && npm run build",
    "start:frontend": "cd client && npm run dev",
    "backend:start:old": "node dist/server.js",
    "backend:dev:old": "cd client && npm run dev",
    "frontend:5174": "cd client && npm run dev -- --port 5174 --host 127.0.0.1",
    "backend:note": "node -e \"console.log('Backend is isolated. Do not run until sqlite/port 8080 is fixed separately.')\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase": "^12.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.23.0",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.0.0"
  }
}