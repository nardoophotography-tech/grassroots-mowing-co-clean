const http = require("http");
const { exec } = require("child_process");
const fs = require("fs");
const path = require("path");

const PORT = 4570;
const ROOT = process.cwd();

function send(res, status, body) {
  res.writeHead(status, {
    "Content-Type": "application/json",
    "Access-Control-Allow-Origin": "*",
    "Access-Control-Allow-Methods": "GET, POST, OPTIONS",
    "Access-Control-Allow-Headers": "Content-Type",
    "Access-Control-Allow-Private-Network": "true"
  });
  res.end(JSON.stringify(body));
}

function run(command, timeout = 300000) {
  return new Promise((resolve) => {
    exec(command, {
      cwd: ROOT,
      shell: "powershell.exe",
      timeout,
      maxBuffer: 1024 * 1024 * 20
    }, (error, stdout, stderr) => {
      resolve({
        ok: !error,
        output: `${stdout || ""}${stderr || ""}`.trim(),
        error: error ? String(error.message || error) : ""
      });
    });
  });
}

function scanFiles() {
  const results = [];

  function walk(dir) {
    const entries = fs.readdirSync(dir, { withFileTypes: true });

    for (const entry of entries) {
      const full = path.join(dir, entry.name);
      const rel = path.relative(ROOT, full);

      if (
        rel.startsWith(".git") ||
        rel.startsWith("node_modules") ||
        rel.startsWith("dist") ||
        rel.startsWith("BACKUP-")
      ) {
        continue;
      }

      if (entry.isDirectory()) {
        walk(full);
      } else {
        results.push(rel);
      }
    }
  }

  walk(ROOT);
  return results.slice(0, 500);
}

async function handleAction(body) {
  const action = body.action;

  if (action === "health") {
    return {
      ok: true,
      message: "Complete. Local Runner is online.",
      output: `Project folder: ${ROOT}`
    };
  }

  if (action === "scanFiles") {
    return {
      ok: true,
      message: "Complete. Project scanned.",
      output: scanFiles().join("\n")
    };
  }

  if (action === "gitStatus") {
    const git = await run("git status --short");
    return {
      ok: git.ok,
      message: git.ok ? "Complete. Git status checked." : "Git status failed.",
      output: git.output || "No changed files."
    };
  }

  if (action === "build") {
    const build = await run("npm run build");
    return {
      ok: build.ok,
      message: build.ok ? "Complete. Build passed." : "Build failed.",
      output: build.output || build.error
    };
  }

  if (action === "diagnose") {
    const build = await run("npm run build");
    const git = await run("git status --short");

    return {
      ok: build.ok,
      message: build.ok ? "Complete. Diagnosis passed." : "Build problem found.",
      output: `BUILD:\n${build.output || build.error}\n\nGIT:\n${git.output || "No changed files."}`
    };
  }

  if (action === "repairBrain") {
    const files = scanFiles().join("\n");
    const git = await run("git status --short");
    const build = await run("npm run build");

    const report = [
      "CHERRY REPAIR BRAIN REPORT",
      "",
      `Time: ${new Date().toISOString()}`,
      `Project folder: ${ROOT}`,
      "",
      "BUILD RESULT:",
      build.ok ? "PASS" : "FAIL",
      "",
      "BUILD OUTPUT:",
      build.output || build.error || "No build output.",
      "",
      "GIT STATUS:",
      git.output || "No changed files.",
      "",
      "PROJECT FILES:",
      files,
      "",
      "REPAIR DECISION:",
      build.ok
        ? "No build repair needed. The app builds successfully."
        : "Build failed. Use the build output above to prepare the next patch."
    ].join("\n");

    fs.writeFileSync(path.join(ROOT, "CHERRY_REPAIR_BRAIN_REPORT.txt"), report, "utf8");

    return {
      ok: build.ok,
      message: build.ok
        ? "Complete. Repair Brain checked the app. Build passed."
        : "Repair Brain found a build problem.",
      output: report
    };
  }


  if (action === "repairBrainV2") {
    const files = scanFiles().join("\n");
    const git = await run("git status --short");
    const build = await run("npm run build");

    const buildText = build.output || build.error || "";
    const lowerBuild = buildText.toLowerCase();
    const findings = [];

    if (build.ok) {
      findings.push("Build passed. No build repair needed.");
    }

    if (lowerBuild.includes("cannot find name")) {
      findings.push("Possible missing function, missing import, or renamed variable.");
    }

    if (lowerBuild.includes("is declared but its value is never read")) {
      findings.push("Unused variable or function detected.");
    }

    if (lowerBuild.includes("missing script")) {
      findings.push("package.json script problem.");
    }

    if (lowerBuild.includes("eaddrinuse")) {
      findings.push("Port already in use. Restart the old process.");
    }

    if (lowerBuild.includes("failed to fetch")) {
      findings.push("Cherry screen cannot reach Local Runner on 127.0.0.1:4570.");
    }

    if (findings.length === 0) {
      findings.push("No known repair pattern matched. Manual review needed.");
    }

    const report = [
      "CHERRY REPAIR BRAIN v2 REPORT",
      "",
      `Time: ${new Date().toISOString()}`,
      `Project folder: ${ROOT}`,
      "",
      "BUILD RESULT:",
      build.ok ? "PASS" : "FAIL",
      "",
      "FINDINGS:",
      findings.map((f, i) => `${i + 1}. ${f}`).join("\n"),
      "",
      "RECOMMENDED NEXT ACTION:",
      build.ok
        ? "No code repair needed right now."
        : "Use the build error to prepare the next patch.",
      "",
      "BUILD OUTPUT:",
      buildText || "No build output.",
      "",
      "GIT STATUS:",
      git.output || "No changed files.",
      "",
      "PROJECT FILES:",
      files
    ].join("\n");

    fs.writeFileSync(path.join(ROOT, "CHERRY_REPAIR_BRAIN_V2_REPORT.txt"), report, "utf8");

    return {
      ok: build.ok,
      message: build.ok
        ? "Complete. Repair Brain v2 checked the app. Build passed."
        : "Repair Brain v2 found a build problem.",
      output: report
    };
  }

  if (action === "repairBrainV3") {
    const files = scanFiles();
    const filesText = files.join("\n");
    const git = await run("git status --short");
    const build = await run("npm run build");

    const buildText = build.output || build.error || "";
    const lowerBuild = buildText.toLowerCase();

    const findings = [];
    const likelyFiles = [];
    const nextActions = [];

    if (build.ok) {
      findings.push("Build passed. No active build error found.");
      nextActions.push("No repair needed right now. Continue with the next feature upgrade.");
    }

    if (lowerBuild.includes("cannot find name")) {
      findings.push("TypeScript cannot find a name. This usually means a missing function, missing variable, wrong spelling, or missing import.");
      nextActions.push("Find the missing name in the build output, then search App.tsx and related files for where it should be declared.");
    }

    if (lowerBuild.includes("is declared but its value is never read")) {
      findings.push("Unused variable or unused function detected.");
      nextActions.push("Remove the unused item or connect it to the UI so it is used.");
    }

    if (lowerBuild.includes("missing script")) {
      findings.push("package.json script problem.");
      likelyFiles.push("package.json");
      nextActions.push("Open package.json and check the scripts section.");
    }

    if (lowerBuild.includes("eaddrinuse")) {
      findings.push("Port already in use.");
      nextActions.push("Stop the old process using the port, then restart the runner.");
    }

    if (lowerBuild.includes("failed to fetch")) {
      findings.push("Cherry screen cannot reach Local Runner.");
      likelyFiles.push("cherry-local-runner.cjs");
      likelyFiles.push("src/App.tsx");
      nextActions.push("Check that Local Runner is online at http://127.0.0.1:4570/health.");
    }

    if (lowerBuild.includes("src/app.tsx") || lowerBuild.includes("src\\app.tsx")) {
      likelyFiles.push("src/App.tsx");
    }

    if (lowerBuild.includes("cherry-local-runner")) {
      likelyFiles.push("cherry-local-runner.cjs");
    }

    if (findings.length === 0) {
      findings.push("No known repair pattern matched.");
      nextActions.push("Open the build output and prepare a targeted patch manually.");
    }

    const uniqueLikelyFiles = [...new Set(likelyFiles)];

    const report = [
      "CHERRY REPAIR BRAIN v3 REPORT",
      "",
      `Time: ${new Date().toISOString()}`,
      `Project folder: ${ROOT}`,
      "",
      "BUILD RESULT:",
      build.ok ? "PASS" : "FAIL",
      "",
      "FINDINGS:",
      findings.map((f, i) => `${i + 1}. ${f}`).join("\n"),
      "",
      "LIKELY FILES TO CHECK:",
      uniqueLikelyFiles.length ? uniqueLikelyFiles.join("\n") : "No specific file identified.",
      "",
      "NEXT FIX PLAN:",
      nextActions.map((a, i) => `${i + 1}. ${a}`).join("\n"),
      "",
      "BUILD OUTPUT:",
      buildText || "No build output.",
      "",
      "GIT STATUS:",
      git.output || "No changed files.",
      "",
      "PROJECT FILES:",
      filesText
    ].join("\n");

    fs.writeFileSync(path.join(ROOT, "CHERRY_REPAIR_BRAIN_V3_REPORT.txt"), report, "utf8");

    return {
      ok: build.ok,
      message: build.ok
        ? "Complete. Repair Brain v3 checked the app. Build passed."
        : "Repair Brain v3 found a build problem.",
      output: report
    };
  }
  if (action === "powershell") {
    const command = String(body.command || "");
    const result = await run(command);
    return {
      ok: result.ok,
      message: result.ok ? "Complete. Command finished." : "Command failed.",
      output: result.output || result.error
    };
  }

  if (action === "savePush") {
    const result = await run('git add .; git commit -m "Cherry self repair update"; git push');
    return {
      ok: result.ok,
      message: result.ok ? "Complete. Changes saved and pushed." : "Save or push needs attention.",
      output: result.output || result.error
    };
  }

  if (action === "deploy") {
    const result = await run("gcloud run deploy cherry-app --source . --region us-central1 --allow-unauthenticated");
    return {
      ok: result.ok,
      message: result.ok ? "Complete. Cherry deployed live." : "Deploy failed.",
      output: result.output || result.error
    };
  }

  return {
    ok: false,
    message: "Unknown action.",
    output: String(action || "")
  };
}

const server = http.createServer((req, res) => {
  if (req.method === "OPTIONS") return send(res, 200, { ok: true });

  if (req.method === "GET" && req.url === "/health") {
    return send(res, 200, {
      ok: true,
      message: "Complete. Local Runner is online.",
      output: `Project folder: ${ROOT}`
    });
  }

  if (req.method === "POST" && req.url === "/run") {
    let raw = "";

    req.on("data", chunk => {
      raw += chunk;
    });

    req.on("end", async () => {
      try {
        const body = raw ? JSON.parse(raw) : {};
        const result = await handleAction(body);
        send(res, result.ok ? 200 : 500, result);
      } catch (error) {
        send(res, 500, {
          ok: false,
          message: "Local Runner error.",
          output: String(error && error.message ? error.message : error)
        });
      }
    });

    return;
  }

  send(res, 404, {
    ok: false,
    message: "Not found.",
    output: req.url
  });
});

server.listen(PORT, "127.0.0.1", () => {
  console.log(`Cherry Local Runner repaired and online: http://127.0.0.1:${PORT}`);
  console.log(`Project folder: ${ROOT}`);
});



