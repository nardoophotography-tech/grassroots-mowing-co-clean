:root {
  --red-dirt: #c05a30;
  --deep-green: #3f5122;
  --bush-green: #667b35;
  --dry-grass: #e2c792;
  --paper: #f8f5f0;
  --white: #ffffff;
  --charcoal: #242424;
  --muted: #6d665a;
  --danger: #b42318;
  --shadow: 0 20px 55px rgba(36, 36, 36, 0.14);
}

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
  background:
    radial-gradient(circle at top left, rgba(192, 90, 48, 0.2), transparent 34rem),
    linear-gradient(135deg, #f8f5f0 0%, #ead6ad 100%);
  color: var(--charcoal);
  min-height: 100vh;
}

button,
select {
  font: inherit;
}

.app-shell {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 290px minmax(0, 1fr);
}

.brand-rail {
  position: sticky;
  top: 0;
  height: 100vh;
  padding: 2rem;
  color: var(--white);
  background:
    linear-gradient(160deg, rgba(36, 36, 36, 0.96), rgba(63, 81, 34, 0.96)),
    var(--deep-green);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  border-right: 8px solid var(--red-dirt);
}

.brand-mark {
  width: 92px;
  height: 92px;
  border-radius: 24px;
  display: grid;
  place-items: center;
  background: var(--red-dirt);
  color: var(--white);
  font-size: 2rem;
  font-weight: 950;
  letter-spacing: -0.08em;
  box-shadow: 0 18px 35px rgba(0, 0, 0, 0.24);
}

.brand-small {
  color: var(--dry-grass);
  text-transform: uppercase;
  font-weight: 900;
  letter-spacing: 0.16em;
  margin-bottom: 0.5rem;
}

.brand-rail h1 {
  font-size: 3rem;
  line-height: 0.9;
  text-transform: uppercase;
  letter-spacing: -0.08em;
}

.brand-location {
  margin-top: 1rem;
  color: rgba(255, 255, 255, 0.75);
  font-weight: 700;
}

.dashboard {
  padding: 2rem;
  max-width: 1440px;
  width: 100%;
}

.hero-panel {
  background:
    linear-gradient(135deg, rgba(36, 36, 36, 0.94), rgba(63, 81, 34, 0.92)),
    var(--charcoal);
  color: var(--white);
  border-radius: 28px;
  padding: 2rem;
  display: flex;
  justify-content: space-between;
  gap: 2rem;
  align-items: center;
  box-shadow: var(--shadow);
  border: 1px solid rgba(226, 199, 146, 0.5);
}

.eyebrow {
  color: var(--dry-grass);
  text-transform: uppercase;
  letter-spacing: 0.16em;
  font-size: 0.8rem;
  font-weight: 950;
  margin-bottom: 0.8rem;
}

.hero-panel h2 {
  font-size: clamp(2.6rem, 5vw, 5.4rem);
  line-height: 0.9;
  text-transform: uppercase;
  letter-spacing: -0.08em;
  margin-bottom: 1rem;
}

.hero-panel p {
  max-width: 780px;
  color: rgba(255, 255, 255, 0.82);
  font-size: 1.05rem;
}

.hero-status {
  background: var(--paper);
  color: var(--charcoal);
  border-radius: 18px;
  padding: 1rem 1.2rem;
  min-width: 220px;
  border-left: 8px solid var(--red-dirt);
}

.hero-status span {
  display: block;
  text-transform: uppercase;
  color: var(--deep-green);
  font-size: 0.78rem;
  font-weight: 950;
}

.hero-status strong {
  display: block;
  font-size: 1.35rem;
  margin-top: 0.2rem;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  margin: 1.25rem 0;
}

.stat-grid article {
  background: rgba(255, 255, 255, 0.92);
  border-radius: 20px;
  padding: 1.25rem;
  box-shadow: 0 12px 30px rgba(36, 36, 36, 0.08);
  border-top: 6px solid var(--red-dirt);
}

.stat-grid span {
  color: var(--deep-green);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-size: 0.78rem;
  font-weight: 950;
}

.stat-grid strong {
  display: block;
  font-size: 2.8rem;
  line-height: 1;
  margin-top: 0.45rem;
}

.workbench {
  display: grid;
  grid-template-columns: minmax(360px, 0.9fr) minmax(420px, 1.1fr);
  gap: 1rem;
  align-items: start;
}

.job-list-panel,
.detail-panel {
  background: rgba(255, 255, 255, 0.93);
  border-radius: 24px;
  padding: 1.25rem;
  box-shadow: var(--shadow);
  border: 1px solid rgba(226, 199, 146, 0.8);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: flex-start;
  margin-bottom: 1rem;
}

.panel-header.tight {
  align-items: center;
}

.panel-header h3 {
  font-size: 1.5rem;
  text-transform: uppercase;
  letter-spacing: -0.04em;
}

.panel-header p {
  color: var(--muted);
  font-weight: 650;
}

.panel-header select,
.panel-header button {
  border: 2px solid var(--dry-grass);
  background: var(--paper);
  color: var(--charcoal);
  border-radius: 12px;
  padding: 0.75rem 0.9rem;
  font-weight: 900;
}

.job-card-list {
  display: grid;
  gap: 0.8rem;
}

.job-card {
  width: 100%;
  text-align: left;
  cursor: pointer;
  border: 2px solid transparent;
  background: var(--paper);
  border-radius: 18px;
  padding: 1rem;
  transition: transform 0.15s ease, border-color 0.15s ease, box-shadow 0.15s ease;
}

.job-card:hover,
.job-card.selected {
  transform: translateY(-2px);
  border-color: var(--red-dirt);
  box-shadow: 0 12px 26px rgba(36, 36, 36, 0.12);
}

.job-card-top {
  display: flex;
  justify-content: space-between;
  gap: 0.8rem;
  align-items: flex-start;
}

.job-card h4 {
  font-size: 1.15rem;
}

.job-card p {
  color: var(--muted);
  font-weight: 650;
  margin-top: 0.2rem;
}

.job-card-summary {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 0.9rem;
  padding-top: 0.8rem;
  border-top: 1px solid rgba(109, 102, 90, 0.2);
}

.job-card-summary span {
  color: var(--deep-green);
  font-weight: 900;
}

.status-pill {
  border-radius: 999px;
  padding: 0.42rem 0.7rem;
  font-size: 0.72rem;
  font-weight: 950;
  letter-spacing: 0.06em;
  background: var(--dry-grass);
  color: var(--charcoal);
  white-space: nowrap;
}

.status-approved,
.status-paid,
.status-completed {
  background: rgba(63, 81, 34, 0.14);
  color: var(--deep-green);
}

.status-pending,
.status-scheduled {
  background: rgba(192, 90, 48, 0.14);
  color: var(--red-dirt);
}

.detail-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.8rem;
}

.detail-grid p {
  background: var(--paper);
  border-radius: 14px;
  padding: 0.9rem;
  display: grid;
  gap: 0.25rem;
}

.detail-grid strong {
  color: var(--deep-green);
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.detail-grid span {
  font-weight: 720;
}

.safe-actions {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.7rem;
  margin: 1rem 0;
}

.safe-actions button,
.draft-panel button {
  border: none;
  border-radius: 14px;
  background: var(--deep-green);
  color: var(--white);
  padding: 0.85rem;
  font-weight: 950;
  cursor: pointer;
}

.safe-actions button:nth-child(2) {
  background: var(--red-dirt);
}

.safe-actions button:nth-child(3) {
  background: var(--charcoal);
}

.draft-panel {
  background: rgba(226, 199, 146, 0.35);
  border-radius: 18px;
  padding: 1rem;
  border: 1px solid rgba(192, 90, 48, 0.25);
}

.draft-panel pre {
  white-space: pre-wrap;
  font-family: inherit;
  background: var(--white);
  border-radius: 14px;
  padding: 1rem;
  line-height: 1.55;
  color: var(--charcoal);
  border-left: 6px solid var(--red-dirt);
}

.job-id-box {
  margin-top: 1rem;
  display: grid;
  gap: 0.35rem;
}

.job-id-box strong {
  color: var(--deep-green);
  text-transform: uppercase;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
}

.job-id-box code {
  word-break: break-word;
  color: var(--muted);
}

.safe-message,
.error-box {
  background: var(--paper);
  border-radius: 16px;
  padding: 1rem;
  color: var(--charcoal);
  font-weight: 750;
}

.error-box {
  border-left: 7px solid var(--danger);
}

@media (max-width: 1100px) {
  .app-shell {
    grid-template-columns: 1fr;
  }

  .brand-rail {
    position: relative;
    height: auto;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
  }

  .workbench {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 720px) {
  .dashboard {
    padding: 1rem;
  }

  .hero-panel,
  .panel-header {
    flex-direction: column;
  }

  .stat-grid,
  .detail-grid,
  .safe-actions {
    grid-template-columns: 1fr;
  }

  .brand-rail h1 {
    font-size: 2rem;
  }
}
