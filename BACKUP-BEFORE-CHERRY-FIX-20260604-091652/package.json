{
  "name": "grassroots-mowing-co",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/cherry-server.js",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.cherry.json",
    "start": "node dist/cherry-server.js",
    "cherry:build": "tsc -p tsconfig.cherry.json",
    "cherry:start": "node dist/cherry-server.js",
    "local-runner:build": "tsc cherry-local-runner.ts --module NodeNext --moduleResolution NodeNext --target ES2022 --outDir dist-local-runner --esModuleInterop",
    "local-runner:start": "node dist-local-runner/cherry-local-runner.js"
  },
  "dependencies": {
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google/genai": "^2.7.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "firebase": "^12.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "simple-git": "^3.36.0",
    "twilio": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.23.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vite-tsconfig-paths": "^5.0.0"
  }
}
