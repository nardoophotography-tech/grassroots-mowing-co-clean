:root {
  font-family: Arial, Helvetica, sans-serif;
  color: #1f321d;
  background: #eef3e7;
}

body {
  margin: 0;
}

button, input, select, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.app {
  min-height: 100vh;
  padding: 20px;
  background: linear-gradient(135deg, #eef3e7, #f5edd8);
}

.nav {
  max-width: 1100px;
  margin: 0 auto 24px;
  background: white;
  border-radius: 22px;
  padding: 14px;
  display: flex;
  justify-content: space-between;
  gap: 12px;
  box-shadow: 0 16px 40px rgba(0,0,0,0.08);
}

.nav button {
  border: 1px solid #d6dfcf;
  background: white;
  border-radius: 999px;
  padding: 10px 14px;
  font-weight: 700;
}

.brand {
  color: #285d29;
}

.hero, .card {
  max-width: 1100px;
  margin: 0 auto;
  background: white;
  border-radius: 30px;
  padding: clamp(24px, 5vw, 60px);
  box-shadow: 0 18px 50px rgba(0,0,0,0.1);
}

.tag {
  color: #765820;
  font-weight: 900;
  text-transform: uppercase;
  letter-spacing: .08em;
}

h1 {
  font-size: clamp(2.4rem, 7vw, 5rem);
  margin: 0 0 18px;
  line-height: .95;
}

.hero p {
  max-width: 700px;
  font-size: 1.2rem;
  line-height: 1.6;
}

.primary {
  border: 0;
  background: linear-gradient(135deg, #2f6b2d, #7b5d2a);
  color: white;
  border-radius: 999px;
  padding: 14px 20px;
  font-weight: 900;
}

.form {
  display: grid;
  gap: 14px;
}

input, select, textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #cbd8c2;
  border-radius: 16px;
  padding: 14px;
}

textarea {
  min-height: 120px;
}

.notice {
  background: #e8f6e2;
  border: 1px solid #b8d8ad;
  border-radius: 16px;
  padding: 14px;
  font-weight: 700;
}

.list {
  display: grid;
  gap: 18px;
}

.booking {
  border: 1px solid #d8e0d0;
  border-radius: 22px;
  padding: 20px;
  background: #fbfbf7;
}

.booking h2 {
  margin-top: 0;
}

.booking select,
.booking textarea,
.booking button {
  margin-top: 10px;
}

.danger {
  border: 1px solid #dbb0a7;
  background: #fff1ee;
  color: #8b321f;
  border-radius: 14px;
  padding: 12px 14px;
  font-weight: 800;
}

@media (max-width: 700px) {
  .nav {
    flex-direction: column;
  }
}
