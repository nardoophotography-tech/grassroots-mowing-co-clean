import { useEffect, useMemo, useRef, useState } from "react";
import "./App.css";

type Page =
  | "dashboard"
  | "book"
  | "bookings"
  | "field"
  | "schedule"
  | "clients"
  | "quotes"
  | "invoices"
  | "reports"
  | "marketing"
  | "inventory"
  | "safety"
  | "settings"
  | "automation";

type BookingStatus =
  | "Pending"
  | "Accepted"
  | "Quoted"
  | "Scheduled"
  | "In Progress"
  | "Completed"
  | "Cancelled";

type PaymentStatus = "Unpaid" | "Deposit Paid" | "Paid" | "Overdue";
type Priority = "Low" | "Normal" | "High" | "Urgent";

type Booking = {
  id: string;
  createdAt: string;
  name: string;
  phone: string;
  email: string;
  address: string;
  suburb: string;
  propertyType: string;
  lawnSize: string;
  serviceType: string;
  addOns: string[];
  preferredDate: string;
  preferredTime: string;
  accessNotes: string;
  dogWarning: string;
  frequency: string;
  estimatedPrice: number;
  finalPrice: number;
  status: BookingStatus;
  paymentStatus: PaymentStatus;
  priority: Priority;
  assignedDateTime: string;
  adminNotes: string;
  beforePhotoNote: string;
  afterPhotoNote: string;
  completionNotes: string;
};

type InventoryItem = {
  id: string;
  name: string;
  category: string;
  currentQty: number;
  minimumQty: number;
  unit: string;
  notes: string;
};

type SafetyRecord = {
  id: string;
  createdAt: string;
  type: string;
  title: string;
  location: string;
  notes: string;
  status: "Open" | "Reviewed" | "Closed";
};

type BusinessSettings = {
  businessName: string;
  phone: string;
  email: string;
  town: string;
  serviceAreasText: string;
  defaultDepositPercent: number;
  quoteTerms: string;
  invoiceTerms: string;
};

const BOOKINGS_KEY = "grassroots_stage_1_95_bookings";
const INVENTORY_KEY = "grassroots_stage_1_95_inventory";
const SAFETY_KEY = "grassroots_stage_1_95_safety";
const SETTINGS_KEY = "grassroots_stage_1_95_settings";

const defaultSettings: BusinessSettings = {
  businessName: "GrassRoots Mowing Co",
  phone: "",
  email: "",
  town: "Mount Isa",
  serviceAreasText: "Mount Isa, Mornington, Healy, Pioneer, Townview, Menzies, The Gap, Winston, Miles End, Parkside, Ryan, Soldiers Hill",
  defaultDepositPercent: 0,
  quoteTerms: "This quote is a guide only and may be confirmed after inspection.",
  invoiceTerms: "Thank you for choosing GrassRoots Mowing Co. Payment is due on completion unless otherwise agreed.",
};

const basePrices: Record<string, number> = {
  "Small": 70,
  "Medium": 95,
  "Large": 140,
  "Very large / ride-on required": 220,
  "Unsure / quote needed": 0,
};

const serviceMultipliers: Record<string, number> = {
  "Standard lawn mowing": 1,
  "Mowing and whipper snipping": 1.25,
  "Ride-on mowing": 1.45,
  "Overgrown yard clean-up": 1.8,
  "Regular maintenance": 0.9,
  "Quote request": 0,
};

const addOnPrices: Record<string, number> = {
  "Green waste removal": 35,
  "Edging": 20,
  "Weed control / poisoning": 30,
  "Blower clean-up": 15,
  "Before and after photos": 10,
  "Extra whipper snipping": 25,
};

const starterInventory: InventoryItem[] = [
  { id: "INV-1", name: "Zero-turn mower blades", category: "Blades", currentQty: 3, minimumQty: 3, unit: "blades", notes: "Keep one full spare set ready." },
  { id: "INV-2", name: "Whipper snipper cord", category: "Consumables", currentQty: 2, minimumQty: 2, unit: "spools", notes: "Check weekly during peak season." },
  { id: "INV-3", name: "Fuel", category: "Fuel", currentQty: 20, minimumQty: 15, unit: "litres", notes: "Keep enough for daily run plus backup." },
  { id: "INV-4", name: "Safety glasses", category: "PPE", currentQty: 2, minimumQty: 2, unit: "pairs", notes: "Replace damaged PPE immediately." },
];

const initialForm = {
  name: "",
  phone: "",
  email: "",
  address: "",
  suburb: "Mount Isa",
  propertyType: "Residential",
  lawnSize: "Medium",
  serviceType: "Mowing and whipper snipping",
  addOns: [] as string[],
  preferredDate: "",
  preferredTime: "Morning",
  accessNotes: "",
  dogWarning: "No dogs",
  frequency: "One-off",
};

const initialSafetyForm = {
  type: "Job site risk assessment",
  title: "",
  location: "",
  notes: "",
};

function loadItem<T>(key: string, fallback: T): T {
  try {
    const raw = localStorage.getItem(key);
    return raw ? JSON.parse(raw) : fallback;
  } catch {
    return fallback;
  }
}

function saveItem<T>(key: string, data: T) {
  localStorage.setItem(key, JSON.stringify(data));
}

function calculateEstimate(form: typeof initialForm) {
  const base = basePrices[form.lawnSize] ?? 0;
  const multiplier = serviceMultipliers[form.serviceType] ?? 1;
  const addOns = form.addOns.reduce((total, item) => total + (addOnPrices[item] ?? 0), 0);
  if (base === 0 || multiplier === 0) return 0;
  return Math.round(base * multiplier + addOns);
}

function formatMoney(amount: number) {
  return amount > 0 ? `$${amount} AUD` : "Quote required";
}

function todayIso() {
  return new Date().toISOString().slice(0, 10);
}

function App() {
  const [page, setPage] = useState<Page>("dashboard");
  const [bookings, setBookings] = useState<Booking[]>([]);
  const [inventory, setInventory] = useState<InventoryItem[]>([]);
  const [safetyRecords, setSafetyRecords] = useState<SafetyRecord[]>([]);
  const [settings, setSettings] = useState<BusinessSettings>(defaultSettings);
  const [form, setForm] = useState(initialForm);
  const [safetyForm, setSafetyForm] = useState(initialSafetyForm);
  const [notice, setNotice] = useState("");
  const [search, setSearch] = useState("");
  const [statusFilter, setStatusFilter] = useState<"All" | BookingStatus>("All");
  const importRef = useRef<HTMLInputElement | null>(null);

  useEffect(() => {
    setBookings(loadItem<Booking[]>(BOOKINGS_KEY, []));
    setInventory(loadItem<InventoryItem[]>(INVENTORY_KEY, starterInventory));
    setSafetyRecords(loadItem<SafetyRecord[]>(SAFETY_KEY, []));
    setSettings(loadItem<BusinessSettings>(SETTINGS_KEY, defaultSettings));
  }, []);

  const serviceAreas = useMemo(
    () => settings.serviceAreasText.split(",").map((area) => area.trim()).filter(Boolean),
    [settings.serviceAreasText]
  );

  const estimate = useMemo(() => calculateEstimate(form), [form]);

  const filteredBookings = useMemo(() => {
    return bookings.filter((booking) => {
      const text = `${booking.name} ${booking.phone} ${booking.email} ${booking.address} ${booking.suburb} ${booking.serviceType}`.toLowerCase();
      return text.includes(search.toLowerCase()) && (statusFilter === "All" || booking.status === statusFilter);
    });
  }, [bookings, search, statusFilter]);

  const clients = useMemo(() => {
    const map = new Map<string, { name: string; phone: string; email: string; addresses: string[]; jobs: number; revenue: number }>();

    bookings.forEach((booking) => {
      const key = `${booking.name}-${booking.phone}`;
      const current = map.get(key) ?? { name: booking.name, phone: booking.phone, email: booking.email, addresses: [], jobs: 0, revenue: 0 };
      const address = `${booking.address}, ${booking.suburb}`;
      if (!current.addresses.includes(address)) current.addresses.push(address);
      current.jobs += 1;
      current.revenue += booking.finalPrice || booking.estimatedPrice;
      map.set(key, current);
    });

    return Array.from(map.values());
  }, [bookings]);

  const runSheetBookings = useMemo(() => {
    return bookings
      .filter((b) => b.status === "Scheduled" || b.status === "In Progress" || b.status === "Accepted")
      .sort((a, b) => (a.assignedDateTime || a.preferredDate).localeCompare(b.assignedDateTime || b.preferredDate));
  }, [bookings]);

  const todaysFieldJobs = useMemo(() => {
    const today = todayIso();
    return bookings.filter((b) =>
      b.status !== "Cancelled" &&
      b.status !== "Completed" &&
      (b.preferredDate === today || b.assignedDateTime.includes(today) || b.status === "In Progress")
    );
  }, [bookings]);

  const stats = useMemo(() => {
    const activeBookings = bookings.filter((b) => b.status !== "Cancelled");
    const revenue = activeBookings.reduce((total, b) => total + (b.finalPrice || b.estimatedPrice), 0);
    const paidRevenue = bookings.filter((b) => b.paymentStatus === "Paid").reduce((total, b) => total + (b.finalPrice || b.estimatedPrice), 0);
    const unpaidRevenue = bookings.filter((b) => b.paymentStatus !== "Paid" && b.status !== "Cancelled").reduce((total, b) => total + (b.finalPrice || b.estimatedPrice), 0);

    return {
      total: bookings.length,
      pending: bookings.filter((b) => b.status === "Pending").length,
      quoted: bookings.filter((b) => b.status === "Quoted").length,
      scheduled: bookings.filter((b) => b.status === "Scheduled").length,
      completed: bookings.filter((b) => b.status === "Completed").length,
      unpaid: bookings.filter((b) => b.paymentStatus === "Unpaid" || b.paymentStatus === "Overdue").length,
      revenue,
      paidRevenue,
      unpaidRevenue,
      clients: clients.length,
      lowStock: inventory.filter((item) => item.currentQty <= item.minimumQty).length,
      openSafety: safetyRecords.filter((record) => record.status === "Open").length,
    };
  }, [bookings, clients.length, inventory, safetyRecords]);

  function saveBookings(next: Booking[]) {
    setBookings(next);
    saveItem(BOOKINGS_KEY, next);
  }

  function saveInventory(next: InventoryItem[]) {
    setInventory(next);
    saveItem(INVENTORY_KEY, next);
  }

  function saveSafety(next: SafetyRecord[]) {
    setSafetyRecords(next);
    saveItem(SAFETY_KEY, next);
  }

  function saveSettings(next: BusinessSettings) {
    setSettings(next);
    saveItem(SETTINGS_KEY, next);
  }

  function updateForm(field: keyof typeof initialForm, value: string | string[]) {
    setForm((current) => ({ ...current, [field]: value }));
  }

  function updateSafetyForm(field: keyof typeof initialSafetyForm, value: string) {
    setSafetyForm((current) => ({ ...current, [field]: value }));
  }

  function updateSetting(field: keyof BusinessSettings, value: string | number) {
    saveSettings({ ...settings, [field]: value });
  }

  function toggleAddOn(addOn: string) {
    updateForm("addOns", form.addOns.includes(addOn) ? form.addOns.filter((item) => item !== addOn) : [...form.addOns, addOn]);
  }

  function submitBooking(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setNotice("");

    if (!form.name.trim() || !form.phone.trim() || !form.address.trim()) {
      setNotice("Please add customer name, phone number, and property address.");
      return;
    }

    const booking: Booking = {
      id: `GR-${Date.now()}`,
      createdAt: new Date().toLocaleString("en-AU"),
      name: form.name.trim(),
      phone: form.phone.trim(),
      email: form.email.trim(),
      address: form.address.trim(),
      suburb: form.suburb,
      propertyType: form.propertyType,
      lawnSize: form.lawnSize,
      serviceType: form.serviceType,
      addOns: form.addOns,
      preferredDate: form.preferredDate,
      preferredTime: form.preferredTime,
      accessNotes: form.accessNotes.trim(),
      dogWarning: form.dogWarning,
      frequency: form.frequency,
      estimatedPrice: estimate,
      finalPrice: estimate,
      status: "Pending",
      paymentStatus: "Unpaid",
      priority: "Normal",
      assignedDateTime: "",
      adminNotes: "",
      beforePhotoNote: "",
      afterPhotoNote: "",
      completionNotes: "",
    };

    saveBookings([booking, ...bookings]);
    setForm(initialForm);
    setNotice("Booking submitted. It now appears in the admin booking dashboard.");
    setPage("bookings");
  }

  function updateBooking(id: string, updates: Partial<Booking>) {
    saveBookings(bookings.map((booking) => booking.id === id ? { ...booking, ...updates } : booking));
  }

  function deleteBooking(id: string) {
    if (!window.confirm("Delete this booking?")) return;
    saveBookings(bookings.filter((booking) => booking.id !== id));
  }

  function updateInventory(id: string, updates: Partial<InventoryItem>) {
    saveInventory(inventory.map((item) => item.id === id ? { ...item, ...updates } : item));
  }

  function addSafetyRecord(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (!safetyForm.title.trim()) {
      setNotice("Add a safety title first.");
      return;
    }

    const record: SafetyRecord = {
      id: `SAFE-${Date.now()}`,
      createdAt: new Date().toLocaleString("en-AU"),
      type: safetyForm.type,
      title: safetyForm.title.trim(),
      location: safetyForm.location.trim(),
      notes: safetyForm.notes.trim(),
      status: "Open",
    };

    saveSafety([record, ...safetyRecords]);
    setSafetyForm(initialSafetyForm);
    setNotice("Safety record added.");
  }

  function updateSafetyRecord(id: string, updates: Partial<SafetyRecord>) {
    saveSafety(safetyRecords.map((record) => record.id === id ? { ...record, ...updates } : record));
  }

  function deleteSafetyRecord(id: string) {
    if (!window.confirm("Delete this safety record?")) return;
    saveSafety(safetyRecords.filter((record) => record.id !== id));
  }

  function exportAllData() {
    const data = { exportedAt: new Date().toLocaleString("en-AU"), version: "stage-1.95", settings, bookings, inventory, safetyRecords };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = `grassroots-operations-backup-${Date.now()}.json`;
    anchor.click();
    URL.revokeObjectURL(url);
  }

  function importBackup(event: React.ChangeEvent<HTMLInputElement>) {
    const file = event.target.files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = () => {
      try {
        const data = JSON.parse(String(reader.result));
        if (Array.isArray(data.bookings)) saveBookings(data.bookings);
        if (Array.isArray(data.inventory)) saveInventory(data.inventory);
        if (Array.isArray(data.safetyRecords)) saveSafety(data.safetyRecords);
        if (data.settings) saveSettings({ ...defaultSettings, ...data.settings });
        setNotice("Backup imported successfully.");
        setPage("dashboard");
      } catch {
        setNotice("Could not import backup. Make sure it is a GrassRoots JSON backup.");
      }
    };
    reader.readAsText(file);
  }

  function clearLocalData() {
    if (!window.confirm("Clear all local GrassRoots test data?")) return;
    saveBookings([]);
    saveInventory(starterInventory);
    saveSafety([]);
    saveSettings(defaultSettings);
    setNotice("Local test data cleared.");
    setPage("dashboard");
  }

  function copyText(text: string, successMessage: string) {
    navigator.clipboard.writeText(text);
    setNotice(successMessage);
  }

  function printPage() {
    window.print();
  }

  return (
    <main className="app">
      <header className="nav">
        <button className="brand" onClick={() => setPage("dashboard")}>
          <span className="brand-badge">GR</span>
          <span>
            <strong>{settings.businessName}</strong>
            <small>Operations Hub · Stage 1.95</small>
          </span>
        </button>

        <div className="nav-buttons">
          <button onClick={() => setPage("dashboard")}>Dashboard</button>
          <button onClick={() => setPage("book")}>Book</button>
          <button onClick={() => setPage("bookings")}>Bookings {stats.pending ? `(${stats.pending})` : ""}</button>
          <button onClick={() => setPage("field")}>Field</button>
          <button onClick={() => setPage("schedule")}>Run Sheet</button>
          <button onClick={() => setPage("clients")}>Clients</button>
          <button onClick={() => setPage("quotes")}>Quotes</button>
          <button onClick={() => setPage("invoices")}>Invoices</button>
          <button onClick={() => setPage("reports")}>Reports</button>
          <button onClick={() => setPage("marketing")}>Marketing</button>
          <button onClick={() => setPage("inventory")}>Inventory</button>
          <button onClick={() => setPage("safety")}>Safety</button>
          <button onClick={() => setPage("settings")}>Settings</button>
          <button onClick={() => setPage("automation")}>Automation</button>
        </div>
      </header>

      {notice && <div className="notice">{notice}</div>}

      {page === "dashboard" && (
        <section className="page">
          <div className="hero-grid">
            <div className="hero">
              <p className="tag">{settings.businessName} · Stage 1.95</p>
              <h1>Local business control centre.</h1>
              <p>
                Adds field mode, business settings, import/restore backup, print run sheet,
                reports, and marketing drafts before cloud automation.
              </p>
              <div className="hero-actions">
                <button className="primary" onClick={() => setPage("book")}>Create booking</button>
                <button className="secondary" onClick={exportAllData}>Export backup</button>
                <button className="secondary" onClick={() => importRef.current?.click()}>Import backup</button>
                <button className="danger" onClick={clearLocalData}>Clear local data</button>
                <input ref={importRef} hidden type="file" accept="application/json" onChange={importBackup} />
              </div>
            </div>

            <aside className="side-panel">
              <h2>Next real upgrade</h2>
              <p>Stage 2 should connect Firebase so this data is saved in the cloud and works across devices.</p>
              <ul>
                <li>Cloud Firestore database</li>
                <li>Admin login protection</li>
                <li>Public booking persistence</li>
                <li>Multi-device sync</li>
              </ul>
            </aside>
          </div>

          <StatsGrid stats={stats} />
        </section>
      )}

      {page === "book" && (
        <section className="card">
          <SectionTitle tag="Customer Booking Hub" title="Book a mowing service" text="Customer details, property profile, service type, add-ons, access notes, and estimate." />

          <form className="form-grid" onSubmit={submitBooking}>
            <label>Customer name<input value={form.name} onChange={(e) => updateForm("name", e.target.value)} /></label>
            <label>Phone number<input value={form.phone} onChange={(e) => updateForm("phone", e.target.value)} /></label>
            <label>Email<input type="email" value={form.email} onChange={(e) => updateForm("email", e.target.value)} /></label>
            <label>Property address<input value={form.address} onChange={(e) => updateForm("address", e.target.value)} /></label>

            <label>
              Suburb / service area
              <select value={form.suburb} onChange={(e) => updateForm("suburb", e.target.value)}>
                {serviceAreas.map((area) => <option key={area}>{area}</option>)}
              </select>
            </label>

            <label>
              Property type
              <select value={form.propertyType} onChange={(e) => updateForm("propertyType", e.target.value)}>
                <option>Residential</option>
                <option>Commercial</option>
                <option>Rental property</option>
                <option>NDIS / support client</option>
                <option>Rural block</option>
                <option>Body corporate</option>
              </select>
            </label>

            <label>
              Lawn size
              <select value={form.lawnSize} onChange={(e) => updateForm("lawnSize", e.target.value)}>
                {Object.keys(basePrices).map((size) => <option key={size}>{size}</option>)}
              </select>
            </label>

            <label>
              Service type
              <select value={form.serviceType} onChange={(e) => updateForm("serviceType", e.target.value)}>
                {Object.keys(serviceMultipliers).map((service) => <option key={service}>{service}</option>)}
              </select>
            </label>

            <label>Preferred date<input type="date" value={form.preferredDate} onChange={(e) => updateForm("preferredDate", e.target.value)} /></label>

            <label>
              Preferred time
              <select value={form.preferredTime} onChange={(e) => updateForm("preferredTime", e.target.value)}>
                <option>Morning</option>
                <option>Middle of day</option>
                <option>Afternoon</option>
                <option>Any time</option>
              </select>
            </label>

            <label>
              Frequency
              <select value={form.frequency} onChange={(e) => updateForm("frequency", e.target.value)}>
                <option>One-off</option>
                <option>Weekly</option>
                <option>Fortnightly</option>
                <option>Monthly</option>
                <option>As needed</option>
              </select>
            </label>

            <label>
              Dogs / access warning
              <select value={form.dogWarning} onChange={(e) => updateForm("dogWarning", e.target.value)}>
                <option>No dogs</option>
                <option>Dogs on property</option>
                <option>Dogs will be locked away</option>
                <option>Gate locked</option>
                <option>Call before arrival</option>
              </select>
            </label>

            <div className="full">
              <p className="field-heading">Add-ons</p>
              <div className="checkbox-grid">
                {Object.keys(addOnPrices).map((addOn) => (
                  <label className="check-row" key={addOn}>
                    <input type="checkbox" checked={form.addOns.includes(addOn)} onChange={() => toggleAddOn(addOn)} />
                    <span>{addOn} <small>${addOnPrices[addOn]}</small></span>
                  </label>
                ))}
              </div>
            </div>

            <label className="full">
              Access notes / job notes
              <textarea value={form.accessNotes} onChange={(e) => updateForm("accessNotes", e.target.value)} placeholder="Gate access, dogs, overgrown areas, parking, preferred contact method..." />
            </label>

            <div className="estimate-box full">
              <span>Estimated price</span>
              <strong>{formatMoney(estimate)}</strong>
              <small>Guide only. Final price can be confirmed manually.</small>
            </div>

            <button className="primary full" type="submit">Submit booking</button>
          </form>
        </section>
      )}

      {page === "bookings" && (
        <section className="card">
          <div className="section-title row-title">
            <div>
              <p className="tag">Admin Control Centre</p>
              <h1>Bookings</h1>
              <p>Search, filter, price, prioritise, schedule, and track payments.</p>
            </div>
            <button className="secondary" onClick={exportAllData}>Export backup</button>
          </div>

          <div className="toolbar">
            <input placeholder="Search name, phone, address, service..." value={search} onChange={(e) => setSearch(e.target.value)} />
            <select value={statusFilter} onChange={(e) => setStatusFilter(e.target.value as "All" | BookingStatus)}>
              <option>All</option>
              <option>Pending</option>
              <option>Accepted</option>
              <option>Quoted</option>
              <option>Scheduled</option>
              <option>In Progress</option>
              <option>Completed</option>
              <option>Cancelled</option>
            </select>
          </div>

          {filteredBookings.length === 0 ? (
            <Empty title="No matching bookings" text="Create a booking or clear your filters." button="Create booking" onClick={() => setPage("book")} />
          ) : (
            <BookingList bookings={filteredBookings} updateBooking={updateBooking} deleteBooking={deleteBooking} copyText={copyText} />
          )}
        </section>
      )}

      {page === "field" && (
        <section className="card">
          <SectionTitle tag="Mobile Field Mode" title="Today's field jobs" text="Use this on the phone while doing jobs. Add before/after notes and complete jobs." />

          {todaysFieldJobs.length === 0 ? (
            <Empty title="No field jobs for today" text="Schedule jobs or start a job first." />
          ) : (
            <div className="booking-list">
              {todaysFieldJobs.map((booking) => (
                <article className="field-card" key={booking.id}>
                  <div className="booking-head">
                    <div>
                      <h2>{booking.name}</h2>
                      <p>{booking.address}, {booking.suburb}</p>
                    </div>
                    <span className={`priority priority-${booking.priority.toLowerCase()}`}>{booking.priority}</span>
                  </div>

                  <div className="quick-actions">
                    <button className="secondary" onClick={() => updateBooking(booking.id, { status: "In Progress" })}>Start job</button>
                    <button className="primary" onClick={() => updateBooking(booking.id, { status: "Completed" })}>Mark completed</button>
                    <button className="secondary" onClick={() => copyText(`${booking.address}, ${booking.suburb}`, "Address copied.")}>Copy address</button>
                    <button className="secondary" onClick={() => copyText(booking.phone, "Phone copied.")}>Copy phone</button>
                  </div>

                  <div className="admin-controls">
                    <label>Before photo note<input value={booking.beforePhotoNote} onChange={(e) => updateBooking(booking.id, { beforePhotoNote: e.target.value })} placeholder="Example: front yard overgrown" /></label>
                    <label>After photo note<input value={booking.afterPhotoNote} onChange={(e) => updateBooking(booking.id, { afterPhotoNote: e.target.value })} placeholder="Example: completed clean finish" /></label>
                    <label className="full">Completion notes<textarea value={booking.completionNotes} onChange={(e) => updateBooking(booking.id, { completionNotes: e.target.value })} /></label>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>
      )}

      {page === "schedule" && (
        <section className="card">
          <div className="section-title row-title">
            <div>
              <p className="tag">Daily Run Sheet</p>
              <h1>Scheduled work</h1>
              <p>Manual run sheet until Google Maps and route optimisation are connected.</p>
            </div>
            <button className="secondary" onClick={printPage}>Print run sheet</button>
          </div>

          {runSheetBookings.length === 0 ? (
            <Empty title="No active scheduled jobs" text="Accept or schedule jobs first." />
          ) : (
            <div className="run-sheet">
              {runSheetBookings.map((booking, index) => (
                <article className="run-card" key={booking.id}>
                  <span className="run-number">{index + 1}</span>
                  <div>
                    <h2>{booking.name}</h2>
                    <p><strong>Time:</strong> {booking.assignedDateTime || `${booking.preferredDate || "No date"} · ${booking.preferredTime}`}</p>
                    <p><strong>Address:</strong> {booking.address}, {booking.suburb}</p>
                    <p><strong>Service:</strong> {booking.serviceType}</p>
                    <p><strong>Access:</strong> {booking.dogWarning} · {booking.accessNotes || "No extra notes"}</p>
                  </div>
                  <span className={`priority priority-${booking.priority.toLowerCase()}`}>{booking.priority}</span>
                </article>
              ))}
            </div>
          )}
        </section>
      )}

      {page === "clients" && (
        <section className="card">
          <SectionTitle tag="Customer Relationship Management" title="Clients and property profiles" text="Created automatically from bookings. Later this becomes the full CRM." />
          <div className="booking-list">
            {clients.length === 0 && <Empty title="No clients yet" text="Submit bookings first." />}
            {clients.map((client) => (
              <article className="booking-card" key={`${client.name}-${client.phone}`}>
                <h2>{client.name}</h2>
                <div className="booking-info">
                  <p><strong>Phone:</strong> {client.phone}</p>
                  <p><strong>Email:</strong> {client.email || "Not supplied"}</p>
                  <p><strong>Total jobs:</strong> {client.jobs}</p>
                  <p><strong>Est. revenue:</strong> ${client.revenue} AUD</p>
                  <p className="full"><strong>Properties:</strong> {client.addresses.join(" | ")}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {page === "quotes" && <DraftPage title="Quote drafts" tag="Quote Builder" text="Generate quote text from bookings." bookings={bookings} type="quote" settings={settings} copyText={copyText} />}
      {page === "invoices" && <DraftPage title="Invoice drafts" tag="Billing and Admin" text="Manual invoice text until Stripe/accounting is connected." bookings={bookings} type="invoice" settings={settings} copyText={copyText} />}

      {page === "reports" && (
        <section className="card">
          <SectionTitle tag="Business Reports" title="Local reporting" text="Simple totals from local app data." />
          <div className="stats-grid">
            <div><span>Total estimated revenue</span><strong>${stats.revenue}</strong></div>
            <div><span>Paid revenue</span><strong>${stats.paidRevenue}</strong></div>
            <div><span>Unpaid revenue</span><strong>${stats.unpaidRevenue}</strong></div>
            <div><span>Average job value</span><strong>${stats.total ? Math.round(stats.revenue / stats.total) : 0}</strong></div>
            <div><span>Completed jobs</span><strong>{stats.completed}</strong></div>
            <div><span>Active clients</span><strong>{stats.clients}</strong></div>
            <div><span>Low stock warnings</span><strong>{stats.lowStock}</strong></div>
            <div><span>Open safety records</span><strong>{stats.openSafety}</strong></div>
          </div>
        </section>
      )}

      {page === "marketing" && (
        <section className="card">
          <SectionTitle tag="Marketing Campaigns" title="Message drafts" text="Copy-ready customer messages until SMS/email automation is connected." />
          <MarketingDrafts settings={settings} copyText={copyText} />
        </section>
      )}

      {page === "inventory" && (
        <section className="card">
          <SectionTitle tag="Material, Parts and PPE" title="Inventory tracker" text="Track blades, spools, fuel, PPE, and reorder warnings." />
          <div className="booking-list">
            {inventory.map((item) => (
              <article className="booking-card" key={item.id}>
                <div className="booking-head">
                  <div>
                    <h2>{item.name}</h2>
                    <p>{item.category} · {item.notes}</p>
                  </div>
                  <span className={item.currentQty <= item.minimumQty ? "status cancelled" : "status completed"}>{item.currentQty <= item.minimumQty ? "Reorder" : "OK"}</span>
                </div>
                <div className="admin-controls">
                  <label>Current quantity<input type="number" value={item.currentQty} onChange={(e) => updateInventory(item.id, { currentQty: Number(e.target.value) })} /></label>
                  <label>Minimum quantity<input type="number" value={item.minimumQty} onChange={(e) => updateInventory(item.id, { minimumQty: Number(e.target.value) })} /></label>
                  <label>Unit<input value={item.unit} onChange={(e) => updateInventory(item.id, { unit: e.target.value })} /></label>
                  <label>Notes<input value={item.notes} onChange={(e) => updateInventory(item.id, { notes: e.target.value })} /></label>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {page === "safety" && (
        <section className="card">
          <SectionTitle tag="OH&S Foundation" title="Safety records" text="Track job site risk assessments, incidents, PPE checks, and training notes." />

          <form className="form-grid safety-form" onSubmit={addSafetyRecord}>
            <label>
              Record type
              <select value={safetyForm.type} onChange={(e) => updateSafetyForm("type", e.target.value)}>
                <option>Job site risk assessment</option>
                <option>Incident / injury report</option>
                <option>PPE check</option>
                <option>Equipment safety check</option>
                <option>Training record</option>
              </select>
            </label>
            <label>Title<input value={safetyForm.title} onChange={(e) => updateSafetyForm("title", e.target.value)} /></label>
            <label>Location<input value={safetyForm.location} onChange={(e) => updateSafetyForm("location", e.target.value)} /></label>
            <label className="full">Notes<textarea value={safetyForm.notes} onChange={(e) => updateSafetyForm("notes", e.target.value)} /></label>
            <button className="primary full" type="submit">Add safety record</button>
          </form>

          <div className="booking-list top-gap">
            {safetyRecords.length === 0 && <Empty title="No safety records yet" text="Add a risk assessment or PPE check." />}
            {safetyRecords.map((record) => (
              <article className="booking-card" key={record.id}>
                <div className="booking-head">
                  <div>
                    <h2>{record.title}</h2>
                    <p>{record.type} · {record.location || "No location"} · {record.createdAt}</p>
                  </div>
                  <span className={`status ${record.status.toLowerCase()}`}>{record.status}</span>
                </div>
                <p>{record.notes || "No notes supplied."}</p>
                <div className="admin-controls">
                  <label>
                    Status
                    <select value={record.status} onChange={(e) => updateSafetyRecord(record.id, { status: e.target.value as SafetyRecord["status"] })}>
                      <option>Open</option>
                      <option>Reviewed</option>
                      <option>Closed</option>
                    </select>
                  </label>
                  <button className="danger" onClick={() => deleteSafetyRecord(record.id)}>Delete safety record</button>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {page === "settings" && (
        <section className="card">
          <SectionTitle tag="Business Settings" title="GrassRoots setup" text="Control basic business details, service areas, and draft wording." />
          <div className="form-grid">
            <label>Business name<input value={settings.businessName} onChange={(e) => updateSetting("businessName", e.target.value)} /></label>
            <label>Phone<input value={settings.phone} onChange={(e) => updateSetting("phone", e.target.value)} /></label>
            <label>Email<input value={settings.email} onChange={(e) => updateSetting("email", e.target.value)} /></label>
            <label>Town<input value={settings.town} onChange={(e) => updateSetting("town", e.target.value)} /></label>
            <label>Default deposit percent<input type="number" value={settings.defaultDepositPercent} onChange={(e) => updateSetting("defaultDepositPercent", Number(e.target.value))} /></label>
            <label className="full">Service areas, separated by commas<textarea value={settings.serviceAreasText} onChange={(e) => updateSetting("serviceAreasText", e.target.value)} /></label>
            <label className="full">Quote terms<textarea value={settings.quoteTerms} onChange={(e) => updateSetting("quoteTerms", e.target.value)} /></label>
            <label className="full">Invoice terms<textarea value={settings.invoiceTerms} onChange={(e) => updateSetting("invoiceTerms", e.target.value)} /></label>
          </div>
        </section>
      )}

      {page === "automation" && (
        <section className="card">
          <SectionTitle tag="Automation Engine Readiness" title="Connector roadmap" text="This screen shows what comes next when the local app is stable." />
          <div className="automation-grid">
            <AutomationCard title="Firebase / Firestore" status="Next" text="Move bookings, clients, inventory, and safety records from local storage into cloud database collections." />
            <AutomationCard title="Admin Auth" status="Next" text="Protect business dashboard while keeping public booking open to customers." />
            <AutomationCard title="SMS / Twilio" status="Later" text="Send customer booking confirmations, reminders, rain delays, and review requests." />
            <AutomationCard title="Stripe" status="Later" text="Create payment links, deposits, invoice payments, and payment status tracking." />
            <AutomationCard title="Google Maps" status="Later" text="Validate addresses and build route optimisation for daily mowing runs." />
            <AutomationCard title="Weather API" status="Later" text="Detect rain, heat risk, and schedule delays for Mount Isa conditions." />
            <AutomationCard title="n8n Workflow Engine" status="Later" text="Connect app events to SMS, email, accounting, parts ordering, and review requests." />
            <AutomationCard title="Accounting" status="Later" text="Export invoices and payments to Xero, QuickBooks, or another accounting tool." />
          </div>
        </section>
      )}
    </main>
  );
}

function SectionTitle({ tag, title, text }: { tag: string; title: string; text: string }) {
  return (
    <div className="section-title">
      <p className="tag">{tag}</p>
      <h1>{title}</h1>
      <p>{text}</p>
    </div>
  );
}

function Empty({ title, text, button, onClick }: { title: string; text: string; button?: string; onClick?: () => void }) {
  return (
    <div className="empty">
      <h2>{title}</h2>
      <p>{text}</p>
      {button && <button className="primary" onClick={onClick}>{button}</button>}
    </div>
  );
}

function StatsGrid({ stats }: { stats: Record<string, number> }) {
  return (
    <div className="stats-grid">
      <div><span>Total jobs</span><strong>{stats.total}</strong></div>
      <div><span>Pending</span><strong>{stats.pending}</strong></div>
      <div><span>Quoted</span><strong>{stats.quoted}</strong></div>
      <div><span>Scheduled</span><strong>{stats.scheduled}</strong></div>
      <div><span>Completed</span><strong>{stats.completed}</strong></div>
      <div><span>Unpaid</span><strong>{stats.unpaid}</strong></div>
      <div><span>Est. revenue</span><strong>${stats.revenue}</strong></div>
      <div><span>Clients</span><strong>{stats.clients}</strong></div>
      <div><span>Low stock</span><strong>{stats.lowStock}</strong></div>
      <div><span>Open safety</span><strong>{stats.openSafety}</strong></div>
    </div>
  );
}

function BookingList({
  bookings,
  updateBooking,
  deleteBooking,
  copyText,
}: {
  bookings: Booking[];
  updateBooking: (id: string, updates: Partial<Booking>) => void;
  deleteBooking: (id: string) => void;
  copyText: (text: string, successMessage: string) => void;
}) {
  return (
    <div className="booking-list">
      {bookings.map((booking) => {
        const reviewText = `Hi ${booking.name}, thanks for choosing GrassRoots Mowing Co. If you were happy with the job, a quick review would really help the business grow.`;

        return (
          <article className="booking-card" key={booking.id}>
            <div className="booking-head">
              <div>
                <h2>{booking.name}</h2>
                <p>{booking.address}, {booking.suburb}</p>
              </div>
              <div className="status-stack">
                <span className={`status ${booking.status.toLowerCase().replaceAll(" ", "-")}`}>{booking.status}</span>
                <span className={`status payment-${booking.paymentStatus.toLowerCase().replaceAll(" ", "-")}`}>{booking.paymentStatus}</span>
                <span className={`priority priority-${booking.priority.toLowerCase()}`}>{booking.priority}</span>
              </div>
            </div>

            <div className="booking-info">
              <p><strong>Phone:</strong> {booking.phone}</p>
              <p><strong>Email:</strong> {booking.email || "Not supplied"}</p>
              <p><strong>Property:</strong> {booking.propertyType}</p>
              <p><strong>Lawn size:</strong> {booking.lawnSize}</p>
              <p><strong>Service:</strong> {booking.serviceType}</p>
              <p><strong>Frequency:</strong> {booking.frequency}</p>
              <p><strong>Preferred:</strong> {booking.preferredDate || "No date"} · {booking.preferredTime}</p>
              <p><strong>Dogs/access:</strong> {booking.dogWarning}</p>
              <p><strong>Add-ons:</strong> {booking.addOns.length ? booking.addOns.join(", ") : "None"}</p>
              <p><strong>Estimate:</strong> {formatMoney(booking.estimatedPrice)}</p>
              <p><strong>Final price:</strong> {formatMoney(booking.finalPrice)}</p>
              <p><strong>Created:</strong> {booking.createdAt}</p>
              <p className="full"><strong>Customer notes:</strong> {booking.accessNotes || "None"}</p>
            </div>

            <div className="admin-controls">
              <label>
                Job status
                <select value={booking.status} onChange={(e) => updateBooking(booking.id, { status: e.target.value as BookingStatus })}>
                  <option>Pending</option>
                  <option>Accepted</option>
                  <option>Quoted</option>
                  <option>Scheduled</option>
                  <option>In Progress</option>
                  <option>Completed</option>
                  <option>Cancelled</option>
                </select>
              </label>

              <label>
                Payment status
                <select value={booking.paymentStatus} onChange={(e) => updateBooking(booking.id, { paymentStatus: e.target.value as PaymentStatus })}>
                  <option>Unpaid</option>
                  <option>Deposit Paid</option>
                  <option>Paid</option>
                  <option>Overdue</option>
                </select>
              </label>

              <label>
                Priority
                <select value={booking.priority} onChange={(e) => updateBooking(booking.id, { priority: e.target.value as Priority })}>
                  <option>Low</option>
                  <option>Normal</option>
                  <option>High</option>
                  <option>Urgent</option>
                </select>
              </label>

              <label>Final price AUD<input type="number" value={booking.finalPrice} onChange={(e) => updateBooking(booking.id, { finalPrice: Number(e.target.value) })} /></label>
              <label>Assigned date/time<input value={booking.assignedDateTime} onChange={(e) => updateBooking(booking.id, { assignedDateTime: e.target.value })} placeholder="Example: Friday 9:30am" /></label>
              <label className="full">Admin notes<textarea value={booking.adminNotes} onChange={(e) => updateBooking(booking.id, { adminNotes: e.target.value })} /></label>

              <button className="secondary" onClick={() => copyText(reviewText, "Review request copied.")}>Copy review request</button>
              <button className="danger" onClick={() => deleteBooking(booking.id)}>Delete booking</button>
            </div>
          </article>
        );
      })}
    </div>
  );
}

function DraftPage({
  title,
  tag,
  text,
  bookings,
  type,
  settings,
  copyText,
}: {
  title: string;
  tag: string;
  text: string;
  bookings: Booking[];
  type: "quote" | "invoice";
  settings: BusinessSettings;
  copyText: (text: string, successMessage: string) => void;
}) {
  return (
    <section className="card">
      <SectionTitle tag={tag} title={title} text={text} />
      <div className="booking-list">
        {bookings.length === 0 && <Empty title="No bookings yet" text="Create bookings first." />}
        {bookings.map((booking) => {
          const amount = booking.finalPrice || booking.estimatedPrice;
          const draft = type === "quote"
            ? `${settings.businessName} Quote\n\nCustomer: ${booking.name}\nPhone: ${booking.phone}\nProperty: ${booking.address}, ${booking.suburb}\n\nService: ${booking.serviceType}\nAdd-ons: ${booking.addOns.length ? booking.addOns.join(", ") : "None"}\nFrequency: ${booking.frequency}\nPreferred time: ${booking.preferredDate || "No date supplied"} · ${booking.preferredTime}\n\nEstimated price: ${formatMoney(amount)}\n\nNotes:\n${booking.accessNotes || "No extra notes supplied."}\n\n${settings.quoteTerms}`
            : `${settings.businessName} Invoice Draft\n\nCustomer: ${booking.name}\nPhone: ${booking.phone}\nProperty: ${booking.address}, ${booking.suburb}\n\nService:\n${booking.serviceType}\n\nAdd-ons:\n${booking.addOns.length ? booking.addOns.join(", ") : "None"}\n\nAmount due: ${formatMoney(amount)}\nPayment status: ${booking.paymentStatus}\n\n${settings.invoiceTerms}`;

          return (
            <article className="booking-card" key={`${type}-${booking.id}`}>
              <div className="booking-head">
                <div>
                  <h2>{booking.name}</h2>
                  <p>{booking.address}, {booking.suburb}</p>
                </div>
                <span className="status scheduled">{formatMoney(amount)}</span>
              </div>
              <pre className="draft-box">{draft}</pre>
              <button className="primary" onClick={() => copyText(draft, `${type === "quote" ? "Quote" : "Invoice"} draft copied.`)}>Copy {type} draft</button>
            </article>
          );
        })}
      </div>
    </section>
  );
}

function MarketingDrafts({ settings, copyText }: { settings: BusinessSettings; copyText: (text: string, successMessage: string) => void }) {
  const drafts = [
    {
      title: "Facebook intro post",
      text: `${settings.businessName} is now taking lawn mowing and yard care bookings around ${settings.town}. Message us to book mowing, whipper snipping, ride-on mowing, yard clean-ups, and regular maintenance.`,
    },
    {
      title: "Review request",
      text: `Thanks for choosing ${settings.businessName}. If you were happy with the job, a quick review would really help the business grow.`,
    },
    {
      title: "Rain delay message",
      text: `Hi, this is ${settings.businessName}. Due to weather, we may need to adjust your mowing booking. We will confirm the next available time as soon as possible.`,
    },
    {
      title: "Regular maintenance offer",
      text: `${settings.businessName} can set up regular mowing so your yard stays under control. Weekly, fortnightly, monthly, or as-needed options available.`,
    },
  ];

  return (
    <div className="automation-grid">
      {drafts.map((draft) => (
        <article className="automation-card" key={draft.title}>
          <div>
            <h2>{draft.title}</h2>
            <p>{draft.text}</p>
          </div>
          <button className="secondary" onClick={() => copyText(draft.text, "Marketing draft copied.")}>Copy</button>
        </article>
      ))}
    </div>
  );
}

function AutomationCard({ title, status, text }: { title: string; status: string; text: string }) {
  return (
    <article className="automation-card">
      <div>
        <h2>{title}</h2>
        <p>{text}</p>
      </div>
      <span className={status === "Next" ? "status scheduled" : "status"}>{status}</span>
    </article>
  );
}

export default App;
