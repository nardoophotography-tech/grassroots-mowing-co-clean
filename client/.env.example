# GrassRoots Mowing Co Firebase Settings
# Copy these into .env.local when you have your Firebase web app config.

VITE_FIREBASE_API_KEY=PASTE_FIREBASE_API_KEY_HERE
VITE_FIREBASE_AUTH_DOMAIN=PASTE_PROJECT_ID.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=PASTE_PROJECT_ID_HERE
VITE_FIREBASE_STORAGE_BUCKET=PASTE_PROJECT_ID.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=PASTE_SENDER_ID_HERE
VITE_FIREBASE_APP_ID=PASTE_APP_ID_HERE

# Optional switch:
# local = browser localStorage only
# firebase = Firestore cloud storage
VITE_GRASSROOTS_DATA_MODE=local

# Temporary local admin protection
# Change this PIN before public use.
VITE_GRASSROOTS_ADMIN_PIN=4176

# Firebase Auth Admin Login
# Used only when VITE_GRASSROOTS_DATA_MODE=firebase and Firebase Auth is enabled.
# Create this user inside Firebase Console > Authentication > Users.
VITE_GRASSROOTS_AUTH_MODE=pin_fallback

# Stage 2.4 Security Flags
# true = public visitors can submit booking requests
VITE_GRASSROOTS_PUBLIC_BOOKINGS=true

# admin_only = business screens require admin login
VITE_GRASSROOTS_SECURITY_MODE=admin_only
