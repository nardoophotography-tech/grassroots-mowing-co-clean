import { useEffect, useMemo, useState } from "react";
import "./App.css";

type Page = "home" | "book" | "admin";
type BookingStatus = "Pending" | "Accepted" | "Scheduled" | "In Progress" | "Completed" | "Cancelled";

type Booking = {
  id: string;
  createdAt: string;
  name: string;
  phone: string;
  email: string;
  address: string;
  suburb: string;
  propertyType: string;
  lawnSize: string;
  serviceType: string;
  addOns: string[];
  preferredDate: string;
  preferredTime: string;
  accessNotes: string;
  dogWarning: string;
  frequency: string;
  estimatedPrice: number;
  status: BookingStatus;
  assignedDateTime: string;
  adminNotes: string;
};

const STORAGE_KEY = "grassroots_stage_1_5_bookings";

const serviceAreas = [
  "Mount Isa",
  "Mornington",
  "Healy",
  "Pioneer",
  "Townview",
  "Menzies",
  "The Gap",
  "Winston",
  "Miles End",
  "Parkside",
  "Ryan",
  "Soldiers Hill",
];

const basePrices: Record<string, number> = {
  "Small": 70,
  "Medium": 95,
  "Large": 140,
  "Very large / ride-on required": 220,
  "Unsure / quote needed": 0,
};

const serviceMultipliers: Record<string, number> = {
  "Standard lawn mowing": 1,
  "Mowing and whipper snipping": 1.25,
  "Ride-on mowing": 1.45,
  "Overgrown yard clean-up": 1.8,
  "Regular maintenance": 0.9,
  "Quote request": 0,
};

const addOnPrices: Record<string, number> = {
  "Green waste removal": 35,
  "Edging": 20,
  "Weed control / poisoning": 30,
  "Blower clean-up": 15,
  "Before and after photos": 10,
  "Extra whipper snipping": 25,
};

const initialForm = {
  name: "",
  phone: "",
  email: "",
  address: "",
  suburb: "Mount Isa",
  propertyType: "Residential",
  lawnSize: "Medium",
  serviceType: "Mowing and whipper snipping",
  addOns: [] as string[],
  preferredDate: "",
  preferredTime: "Morning",
  accessNotes: "",
  dogWarning: "No dogs",
  frequency: "One-off",
};

function calculateEstimate(form: typeof initialForm) {
  const base = basePrices[form.lawnSize] ?? 0;
  const multiplier = serviceMultipliers[form.serviceType] ?? 1;
  const addOns = form.addOns.reduce((total, item) => total + (addOnPrices[item] ?? 0), 0);

  if (base === 0 || multiplier === 0) return 0;

  return Math.round(base * multiplier + addOns);
}

function loadBookings(): Booking[] {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    return raw ? JSON.parse(raw) : [];
  } catch {
    return [];
  }
}

function App() {
  const [page, setPage] = useState<Page>("home");
  const [bookings, setBookings] = useState<Booking[]>([]);
  const [form, setForm] = useState(initialForm);
  const [notice, setNotice] = useState("");

  useEffect(() => {
    setBookings(loadBookings());
  }, []);

  const estimate = useMemo(() => calculateEstimate(form), [form]);

  const stats = useMemo(() => {
    return {
      total: bookings.length,
      pending: bookings.filter((b) => b.status === "Pending").length,
      scheduled: bookings.filter((b) => b.status === "Scheduled").length,
      completed: bookings.filter((b) => b.status === "Completed").length,
      estimatedRevenue: bookings
        .filter((b) => b.status !== "Cancelled")
        .reduce((total, b) => total + b.estimatedPrice, 0),
    };
  }, [bookings]);

  function saveBookings(nextBookings: Booking[]) {
    setBookings(nextBookings);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(nextBookings));
  }

  function updateForm(field: keyof typeof initialForm, value: string | string[]) {
    setForm((current) => ({ ...current, [field]: value }));
  }

  function toggleAddOn(addOn: string) {
    const next = form.addOns.includes(addOn)
      ? form.addOns.filter((item) => item !== addOn)
      : [...form.addOns, addOn];

    updateForm("addOns", next);
  }

  function submitBooking(event: React.FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setNotice("");

    if (!form.name.trim() || !form.phone.trim() || !form.address.trim()) {
      setNotice("Please add customer name, phone number, and property address.");
      return;
    }

    const booking: Booking = {
      id: `GR-${Date.now()}`,
      createdAt: new Date().toLocaleString("en-AU"),
      name: form.name.trim(),
      phone: form.phone.trim(),
      email: form.email.trim(),
      address: form.address.trim(),
      suburb: form.suburb,
      propertyType: form.propertyType,
      lawnSize: form.lawnSize,
      serviceType: form.serviceType,
      addOns: form.addOns,
      preferredDate: form.preferredDate,
      preferredTime: form.preferredTime,
      accessNotes: form.accessNotes.trim(),
      dogWarning: form.dogWarning,
      frequency: form.frequency,
      estimatedPrice: estimate,
      status: "Pending",
      assignedDateTime: "",
      adminNotes: "",
    };

    saveBookings([booking, ...bookings]);
    setForm(initialForm);
    setNotice("Booking submitted. It now appears in the admin dashboard.");
    setPage("admin");
  }

  function updateBooking(id: string, updates: Partial<Booking>) {
    saveBookings(bookings.map((booking) => booking.id === id ? { ...booking, ...updates } : booking));
  }

  function deleteBooking(id: string) {
    const confirmDelete = window.confirm("Delete this booking?");
    if (!confirmDelete) return;

    saveBookings(bookings.filter((booking) => booking.id !== id));
  }

  function clearAllBookings() {
    const confirmClear = window.confirm("Clear all local test bookings?");
    if (!confirmClear) return;

    saveBookings([]);
    setNotice("All local bookings cleared.");
  }

  function exportBookings() {
    const data = JSON.stringify(bookings, null, 2);
    const blob = new Blob([data], { type: "application/json" });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement("a");
    anchor.href = url;
    anchor.download = `grassroots-bookings-${Date.now()}.json`;
    anchor.click();
    URL.revokeObjectURL(url);
  }

  return (
    <main className="app">
      <header className="nav">
        <button className="brand" onClick={() => setPage("home")}>
          <span className="brand-badge">GR</span>
          <span>
            <strong>GrassRoots Mowing Co</strong>
            <small>Mount Isa lawn care system</small>
          </span>
        </button>

        <div className="nav-buttons">
          <button onClick={() => setPage("home")}>Home</button>
          <button onClick={() => setPage("book")}>Book Now</button>
          <button onClick={() => setPage("admin")}>Admin {stats.pending ? `(${stats.pending})` : ""}</button>
        </div>
      </header>

      {notice && <div className="notice global-notice">{notice}</div>}

      {page === "home" && (
        <section className="hero-grid">
          <div className="hero">
            <p className="tag">GrassRoots Mowing Co · Stage 1.5</p>
            <h1>Booking and admin control centre.</h1>
            <p>
              This version gives GrassRoots Mowing Co a working customer booking flow,
              price estimate, property profile capture, and admin job dashboard.
            </p>

            <div className="hero-actions">
              <button className="primary" onClick={() => setPage("book")}>Book a mowing job</button>
              <button className="secondary" onClick={() => setPage("admin")}>Open admin dashboard</button>
            </div>
          </div>

          <aside className="side-panel">
            <h2>Active now</h2>
            <ul>
              <li>Customer booking hub</li>
              <li>Property profile setup</li>
              <li>Service area selector</li>
              <li>Local booking storage</li>
              <li>Admin job status control</li>
              <li>Booking export backup</li>
            </ul>

            <h2>Later automation</h2>
            <p>
              Firebase, SMS, Stripe, Google Maps, weather, accounting, PPE,
              inventory, and n8n automation come after this local flow is tested.
            </p>
          </aside>
        </section>
      )}

      {page === "book" && (
        <section className="card">
          <div className="section-title">
            <p className="tag">Customer Booking Hub</p>
            <h1>Book a mowing service</h1>
            <p>Customer details, property profile, job type, add-ons, and estimate.</p>
          </div>

          <form className="form-grid" onSubmit={submitBooking}>
            <label>
              Customer name
              <input value={form.name} onChange={(e) => updateForm("name", e.target.value)} />
            </label>

            <label>
              Phone number
              <input value={form.phone} onChange={(e) => updateForm("phone", e.target.value)} />
            </label>

            <label>
              Email
              <input type="email" value={form.email} onChange={(e) => updateForm("email", e.target.value)} />
            </label>

            <label>
              Property address
              <input value={form.address} onChange={(e) => updateForm("address", e.target.value)} />
            </label>

            <label>
              Suburb / service area
              <select value={form.suburb} onChange={(e) => updateForm("suburb", e.target.value)}>
                {serviceAreas.map((area) => <option key={area}>{area}</option>)}
              </select>
            </label>

            <label>
              Property type
              <select value={form.propertyType} onChange={(e) => updateForm("propertyType", e.target.value)}>
                <option>Residential</option>
                <option>Commercial</option>
                <option>Rental property</option>
                <option>NDIS / support client</option>
                <option>Rural block</option>
                <option>Body corporate</option>
              </select>
            </label>

            <label>
              Lawn size
              <select value={form.lawnSize} onChange={(e) => updateForm("lawnSize", e.target.value)}>
                {Object.keys(basePrices).map((size) => <option key={size}>{size}</option>)}
              </select>
            </label>

            <label>
              Service type
              <select value={form.serviceType} onChange={(e) => updateForm("serviceType", e.target.value)}>
                {Object.keys(serviceMultipliers).map((service) => <option key={service}>{service}</option>)}
              </select>
            </label>

            <label>
              Preferred date
              <input type="date" value={form.preferredDate} onChange={(e) => updateForm("preferredDate", e.target.value)} />
            </label>

            <label>
              Preferred time
              <select value={form.preferredTime} onChange={(e) => updateForm("preferredTime", e.target.value)}>
                <option>Morning</option>
                <option>Middle of day</option>
                <option>Afternoon</option>
                <option>Any time</option>
              </select>
            </label>

            <label>
              Frequency
              <select value={form.frequency} onChange={(e) => updateForm("frequency", e.target.value)}>
                <option>One-off</option>
                <option>Weekly</option>
                <option>Fortnightly</option>
                <option>Monthly</option>
                <option>As needed</option>
              </select>
            </label>

            <label>
              Dogs / access warning
              <select value={form.dogWarning} onChange={(e) => updateForm("dogWarning", e.target.value)}>
                <option>No dogs</option>
                <option>Dogs on property</option>
                <option>Dogs will be locked away</option>
                <option>Gate locked</option>
                <option>Call before arrival</option>
              </select>
            </label>

            <div className="full">
              <p className="field-heading">Add-ons</p>
              <div className="checkbox-grid">
                {Object.keys(addOnPrices).map((addOn) => (
                  <label className="check-row" key={addOn}>
                    <input
                      type="checkbox"
                      checked={form.addOns.includes(addOn)}
                      onChange={() => toggleAddOn(addOn)}
                    />
                    <span>{addOn} <small>${addOnPrices[addOn]}</small></span>
                  </label>
                ))}
              </div>
            </div>

            <label className="full">
              Access notes / job notes
              <textarea
                value={form.accessNotes}
                onChange={(e) => updateForm("accessNotes", e.target.value)}
                placeholder="Gate access, overgrown areas, parking, dog instructions, preferred contact method..."
              />
            </label>

            <div className="estimate-box full">
              <span>Estimated price</span>
              <strong>{estimate > 0 ? `$${estimate} AUD` : "Quote required"}</strong>
              <small>This is a guide only. Final price can be confirmed by GrassRoots Mowing Co.</small>
            </div>

            <button className="primary full" type="submit">Submit booking</button>
          </form>
        </section>
      )}

      {page === "admin" && (
        <section className="card">
          <div className="section-title admin-title">
            <div>
              <p className="tag">Admin Control Centre</p>
              <h1>Booking dashboard</h1>
              <p>Manage incoming jobs, statuses, admin notes, and local backups.</p>
            </div>

            <div className="admin-actions">
              <button className="secondary" onClick={exportBookings} disabled={!bookings.length}>Export backup</button>
              <button className="danger" onClick={clearAllBookings} disabled={!bookings.length}>Clear test data</button>
            </div>
          </div>

          <div className="stats-grid">
            <div><span>Total</span><strong>{stats.total}</strong></div>
            <div><span>Pending</span><strong>{stats.pending}</strong></div>
            <div><span>Scheduled</span><strong>{stats.scheduled}</strong></div>
            <div><span>Completed</span><strong>{stats.completed}</strong></div>
            <div><span>Est. revenue</span><strong>${stats.estimatedRevenue}</strong></div>
          </div>

          {bookings.length === 0 ? (
            <div className="empty">
              <h2>No bookings yet</h2>
              <p>Create a test booking to check the full flow.</p>
              <button className="primary" onClick={() => setPage("book")}>Create test booking</button>
            </div>
          ) : (
            <div className="booking-list">
              {bookings.map((booking) => (
                <article className="booking-card" key={booking.id}>
                  <div className="booking-head">
                    <div>
                      <h2>{booking.name}</h2>
                      <p>{booking.address}, {booking.suburb}</p>
                    </div>
                    <span className={`status ${booking.status.toLowerCase().replaceAll(" ", "-")}`}>
                      {booking.status}
                    </span>
                  </div>

                  <div className="booking-info">
                    <p><strong>Phone:</strong> {booking.phone}</p>
                    <p><strong>Email:</strong> {booking.email || "Not supplied"}</p>
                    <p><strong>Property:</strong> {booking.propertyType}</p>
                    <p><strong>Lawn size:</strong> {booking.lawnSize}</p>
                    <p><strong>Service:</strong> {booking.serviceType}</p>
                    <p><strong>Frequency:</strong> {booking.frequency}</p>
                    <p><strong>Preferred:</strong> {booking.preferredDate || "No date"} · {booking.preferredTime}</p>
                    <p><strong>Dogs/access:</strong> {booking.dogWarning}</p>
                    <p><strong>Add-ons:</strong> {booking.addOns.length ? booking.addOns.join(", ") : "None"}</p>
                    <p><strong>Estimate:</strong> {booking.estimatedPrice ? `$${booking.estimatedPrice} AUD` : "Quote required"}</p>
                    <p><strong>Created:</strong> {booking.createdAt}</p>
                    <p><strong>Customer notes:</strong> {booking.accessNotes || "None"}</p>
                  </div>

                  <div className="admin-controls">
                    <label>
                      Job status
                      <select
                        value={booking.status}
                        onChange={(e) => updateBooking(booking.id, { status: e.target.value as BookingStatus })}
                      >
                        <option>Pending</option>
                        <option>Accepted</option>
                        <option>Scheduled</option>
                        <option>In Progress</option>
                        <option>Completed</option>
                        <option>Cancelled</option>
                      </select>
                    </label>

                    <label>
                      Assigned date/time
                      <input
                        value={booking.assignedDateTime}
                        onChange={(e) => updateBooking(booking.id, { assignedDateTime: e.target.value })}
                        placeholder="Example: Friday 9:30am"
                      />
                    </label>

                    <label className="full">
                      Admin notes
                      <textarea
                        value={booking.adminNotes}
                        onChange={(e) => updateBooking(booking.id, { adminNotes: e.target.value })}
                        placeholder="Internal notes, pricing, access, customer preferences..."
                      />
                    </label>

                    <button className="danger full" onClick={() => deleteBooking(booking.id)}>
                      Delete booking
                    </button>
                  </div>
                </article>
              ))}
            </div>
          )}
        </section>
      )}
    </main>
  );
}

export default App;
