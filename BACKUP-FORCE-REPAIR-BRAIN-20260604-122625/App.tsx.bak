import React, { useRef, useState } from "react";

declare global {
  interface Window {
    SpeechRecognition?: any;
    webkitSpeechRecognition?: any;
  }
}

type Mode = "LOCAL" | "RUNNER" | "VOICE" | "PERMISSION" | "ERROR";
type Pending = null | {
  label: string;
  body: any;
};

const RUNNER_URL = "http://127.0.0.1:4570";

function speak(text: string) {
  if (!("speechSynthesis" in window)) return;
  window.speechSynthesis.cancel();

  const utterance = new SpeechSynthesisUtterance(text);
  utterance.lang = "en-AU";
  window.speechSynthesis.speak(utterance);
}

export default function App() {
  const [inputText, setInputText] = useState("");
  const [output, setOutput] = useState("I’m ready.");
  const [details, setDetails] = useState("");
  const [status, setStatus] = useState<Mode>("LOCAL");
  const [speakerOn, setSpeakerOn] = useState(false);
  const [voiceOn, setVoiceOn] = useState(false);
  const [pending, setPending] = useState<Pending>(null);

  const recognitionRef = useRef<any>(null);
  const voiceOnRef = useRef(false);

  function reply(text: string, mode: Mode = "LOCAL", read = false, extra = "") {
    setStatus(mode);
    setOutput(text);
    setDetails(extra);

    if (speakerOn && read) {
      speak(text);
    }
  }

  async function callRunner(body: any) {
    const response = await fetch(`${RUNNER_URL}/run`, {
      method: "POST",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify(body)
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(`${data.message || "Runner failed"}\n\n${data.output || ""}`);
    }

    return data;
  }

  async function runRunner(body: any) {
    try {
      reply("Working.", "RUNNER", false);

      const data = await callRunner(body);

      reply(data.message || "Complete.", "RUNNER", true, data.output || "");
    } catch (error: any) {
      reply("Needs attention.", "ERROR", true, String(error?.message || error));
    }
  }

  function askPermission(label: string, body: any) {
    setPending({ label, body });
    reply(`Permission needed. Say yes to ${label}.`, "PERMISSION", true);
  }

  async function approvePending() {
    if (!pending) {
      reply("No permission request is waiting.", "LOCAL", false);
      return;
    }

    const job = pending;
    setPending(null);
    await runRunner(job.body);
  }

  function rejectPending() {
    setPending(null);
    reply("Cancelled.", "LOCAL", true);
  }

  function toggleSpeaker() {
    const next = !speakerOn;
    setSpeakerOn(next);

    if (next) {
      setOutput("Speaker ON.");
      speak("Speaker on.");
    } else {
      window.speechSynthesis?.cancel();
      setOutput("Speaker OFF.");
    }
  }

  function startVoice() {
    const SpeechRecognition =
      window.SpeechRecognition || window.webkitSpeechRecognition;

    if (!SpeechRecognition) {
      reply("Voice is not available in this browser.", "VOICE", true);
      return;
    }

    voiceOnRef.current = true;
    setVoiceOn(true);

    const recognition = new SpeechRecognition();
    recognitionRef.current = recognition;

    recognition.lang = "en-AU";
    recognition.continuous = true;
    recognition.interimResults = false;

    recognition.onstart = () => {
      reply("I’m listening.", "VOICE", true);
    };

    recognition.onresult = (event: any) => {
      const last = event.results[event.results.length - 1];
      const transcript = last?.[0]?.transcript?.trim() || "";

      if (!transcript) return;

      setInputText("");
      runCommand(transcript);
    };

    recognition.onend = () => {
      if (voiceOnRef.current) {
        try {
          recognition.start();
        } catch {
          // browser pause
        }
      } else {
        setVoiceOn(false);
      }
    };

    try {
      recognition.start();
    } catch {
      reply("Voice could not start.", "VOICE", true);
    }
  }

  function stopVoice() {
    voiceOnRef.current = false;
    setVoiceOn(false);

    try {
      recognitionRef.current?.stop?.();
    } catch {
      // ignore
    }

    window.speechSynthesis?.cancel();
    reply("Voice stopped.", "VOICE", true);
  }

  function looksLikePowerShell(command: string) {
    const lower = command.toLowerCase();

    return (
      lower.includes("set-location") ||
      lower.includes("set-content") ||
      lower.includes("copy-item") ||
      lower.includes("new-item") ||
      lower.includes("npm run") ||
      lower.includes("git ") ||
      lower.includes("gcloud ") ||
      lower.includes("powershell") ||
      lower.includes("@'") ||
      lower.includes("'@")
    );
  }

  async function runCommand(raw: string) {
    const command = raw.trim();
    const lower = command.toLowerCase();

    if (!command) return;

    if (lower === "yes" || lower === "yes yes yes" || lower === "approve" || lower === "permission granted") {
      return approvePending();
    }

    if (lower === "no" || lower === "no no no" || lower === "cancel") {
      return rejectPending();
    }

    if (lower.includes("check runner") || lower.includes("local runner")) {
      return runRunner({ action: "health" });
    }

    if (lower.includes("scan files") || lower.includes("scan project")) {
      return runRunner({ action: "scanFiles" });
    }

    if (lower.startsWith("read file ")) {
      const path = command.slice("read file ".length).trim();
      return runRunner({ action: "readFile", path });
    }

    if (lower.includes("build") || lower.includes("test")) {
      return runRunner({ action: "build" });
    }

    if (lower.includes("diagnose") || lower.includes("check everything")) {
      return runRunner({ action: "diagnose" });
    }

    if (lower.includes("git status")) {
      return runRunner({ action: "gitStatus" });
    }

    if (lower.includes("save") || lower.includes("push")) {
      return askPermission("save and push changes", { action: "savePush" });
    }

    if (lower.includes("deploy")) {
      return askPermission("deploy Cherry live", { action: "deploy" });
    }

    if (lower.includes("speaker")) {
      return toggleSpeaker();
    }

    if (lower.includes("start voice")) {
      return startVoice();
    }

    if (lower.includes("stop voice") || lower.includes("stop audio")) {
      return stopVoice();
    }

    if (looksLikePowerShell(command)) {
      return askPermission("run this repair patch", {
        action: "powershell",
        command
      });
    }

    reply("Instruction received.", "LOCAL", false);
  }

  async function sendAndClear(raw: string) {
    const command = raw.trim();
    setInputText("");
    await runCommand(command);
  }

  const statusText =
    status === "RUNNER"
      ? "LOCAL RUNNER"
      : status === "VOICE"
      ? voiceOn
        ? "VOICE LISTENING"
        : "VOICE MODE"
      : status === "PERMISSION"
      ? "PERMISSION NEEDED"
      : status === "ERROR"
      ? "NEEDS ATTENTION"
      : "LOCAL MODE";

  const buttons: Array<[string, string]> = [
    ["Check Runner", "check runner"],
    ["Scan Project", "scan project"],
    ["Build / Test", "run build"],
    ["Diagnose", "check everything"],
    ["Git Status", "git status"],
    ["Save + Push", "save and push"],
    ["Deploy", "deploy"],
    [speakerOn ? "Speaker ON" : "Speaker OFF", "speaker"],
    [voiceOn ? "Voice ON" : "Start Voice", "start voice"],
    ["Stop Voice", "stop voice"]
  ];

  return (
    <div
      style={{
        minHeight: "100vh",
        background: "#050507",
        color: "#f2f2f4",
        fontFamily: "Segoe UI, Arial, sans-serif",
        padding: "1.5rem",
        display: "grid",
        placeItems: "start center"
      }}
    >
      <main
        style={{
          width: "min(980px, 96vw)",
          background: "#121217",
          border: "1px solid #252532",
          borderRadius: "28px",
          padding: "1.5rem",
          boxShadow: "0 30px 80px rgba(0,0,0,0.45)"
        }}
      >
        <header style={{ textAlign: "center", marginBottom: "1rem" }}>
          <h1 style={{ margin: 0, color: "#ff2f70", letterSpacing: "0.14em" }}>
            CHERRY
          </h1>
          <p style={{ color: "#9a9aaa", fontWeight: 700 }}>
            Local-first repair and control centre
          </p>
        </header>

        <section
          style={{
            background:
              status === "PERMISSION"
                ? "#3a2510"
                : status === "ERROR"
                ? "#3a1010"
                : "#0f2b18",
            border: "1px solid #333340",
            borderRadius: "14px",
            padding: "0.9rem",
            marginBottom: "1rem",
            textAlign: "center",
            fontWeight: 900,
            color:
              status === "PERMISSION"
                ? "#ffd166"
                : status === "ERROR"
                ? "#ff6b6b"
                : "#31ff5f"
          }}
        >
          {statusText}
        </section>

        <section
          style={{
            display: "grid",
            gridTemplateColumns: "repeat(auto-fit, minmax(130px, 1fr))",
            gap: "0.75rem",
            marginBottom: "1rem"
          }}
        >
          {buttons.map(([label, command]) => (
            <button
              key={command}
              type="button"
              onClick={() => runCommand(command)}
              style={{
                border: "none",
                borderRadius: "16px",
                padding: "1rem",
                background: "#2b2b33",
                color: "#ffffff",
                fontWeight: 900,
                cursor: "pointer",
                minHeight: "68px"
              }}
            >
              {label}
            </button>
          ))}
        </section>

        <section
          style={{
            background: "#050507",
            borderRadius: "14px",
            padding: "1.2rem",
            minHeight: "100px",
            whiteSpace: "pre-wrap",
            color: "#e2e2ea",
            lineHeight: 1.55,
            marginBottom: "1rem",
            border: "1px solid #1c1c24",
            fontSize: "1.1rem",
            fontWeight: 700
          }}
        >
          {output}
        </section>

        {details ? (
          <details
            style={{
              background: "#09090d",
              border: "1px solid #222230",
              borderRadius: "14px",
              padding: "1rem",
              marginBottom: "1rem",
              color: "#cfcfd8"
            }}
          >
            <summary style={{ cursor: "pointer", fontWeight: 900 }}>
              Details
            </summary>
            <pre style={{ whiteSpace: "pre-wrap", overflowX: "auto" }}>
              {details}
            </pre>
          </details>
        ) : null}

        <section
          style={{
            display: "grid",
            gridTemplateColumns: "1fr auto",
            gap: "0.75rem"
          }}
        >
          <textarea
            value={inputText}
            onChange={(event) => setInputText(event.target.value)}
            onKeyDown={(event) => {
              if (event.key === "Enter" && !event.shiftKey) {
                event.preventDefault();
                sendAndClear(inputText);
              }
            }}
            placeholder="Talk to Cherry, or paste a repair patch here. Press Enter to send. Shift+Enter for a new line."
            rows={4}
            style={{
              background: "#181820",
              border: "1px solid #2a2a35",
              color: "#ffffff",
              borderRadius: "12px",
              padding: "1rem",
              fontSize: "1rem",
              resize: "vertical"
            }}
          />

          <button
            type="button"
            onClick={() => sendAndClear(inputText)}
            style={{
              border: "none",
              borderRadius: "12px",
              padding: "1rem 1.4rem",
              background: "#ff2f70",
              color: "#ffffff",
              fontWeight: 900,
              cursor: "pointer"
            }}
          >
            SEND
          </button>
        </section>
      </main>
    </div>
  );
}
